APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql://pashu:pashu@127.0.0.1:5432/pashumauli
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
DEMO_MODE=false

# Authentication
JWT_SECRET=replace-with-local-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=604800
RATE_LIMIT_AUTH_PER_MINUTE=10

# Storage
STORAGE_PROVIDER=mock
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
BEDROCK_MODEL_ID=

# Telephony & Voice
TELEPHONY_PROVIDER=mock
EXOTEL_ENABLED=true
EXOTEL_WEBHOOK_SHARED_SECRET=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_VIRTUAL_NUMBER=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

MSG91_AUTH_KEY=
MSG91_SENDER_ID=

STT_PROVIDER=mock
TTS_PROVIDER=mock

# Push Notifications
FIREBASE_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# Outbreak Detection
OUTBREAK_MIN_CASES=3
OUTBREAK_RADIUS_KM=10
OUTBREAK_WINDOW_DAYS=14
